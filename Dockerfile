# ViMax API (FastAPI) – brands, games, characters, pipelines
FROM python:3.12-slim

WORKDIR /app

# Install system deps for opencv and similar (optional; remove if not needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app/

# Ensure api, agents, interfaces, pipelines, tools, utils are on path
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
