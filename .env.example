# ViMax Environment Variables
# Copy this file to .env and fill in your API keys

# ============== Chat Model ==============
# xAI Grok (primary for concept generation)
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-beta

# OpenRouter (alternative)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============== Image/Video Generation ==============
# Google Gemini/Veo
GEMINI_API_KEY=your_gemini_api_key_here

# PiAPI (fallback and primary for API)
PIAPI_API_KEY=your_piapi_api_key_here

# KieAI (primary for multimedia)
KIEAI_API_KEY=your_kieai_api_key_here
PIAPI_IMAGE_MODEL=nano-banana-pro
PIAPI_VIDEO_MODEL=veo3.1
PIAPI_AUDIO_MODEL=Qubico/mmaudio
PIAPI_TTS_MODEL=Qubico/tts
PIAPI_MUSIC_MODEL=suno-v5
PIAPI_MUSIC_TASK_TYPE=music

# ============== Voice Generation ==============
# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_MODEL=music_v1
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# ============== Video Analysis ==============
# TwelveLabs
TWELVELABS_API_KEY=your_twelvelabs_api_key_here

# ============== AWS S3 (Asset Storage) ==============
# Required for S3 API (presign, list) and storage. boto3 uses these.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=intelli-verse-x-media
S3_ASSET_PREFIX=agent-assets
# Optional: for S3-compatible stores (MinIO, LocalStack)
# AWS_ENDPOINT_URL=http://localhost:9000
# Optional: default expiry for presigned URLs (seconds)
# S3_PRESIGN_EXPIRES_DEFAULT=3600

# ============== YouTube/Google OAuth ==============
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_API_KEY=your_youtube_api_key

# ============== Trend Analysis (for trendy flag) ==============
# Google Trends (no API key needed)
GOOGLE_TRENDS_ENABLED=true

# NewsAPI (optional)
NEWSAPI_KEY=your_newsapi_key_here

# Reddit (no API key needed for public access)
REDDIT_ENABLED=true

# ============== API Server ==============
API_HOST=0.0.0.0
API_PORT=8000

# ============== S3 Pattern Configuration ==============
# These define the structure for brands/games/characters in S3
# Pattern: s3://{bucket}/{prefix}/brands/{brand_id}/Characters/{CharacterName}/
# Pattern: s3://{bucket}/{prefix}/games/{game_id}/Characters/{CharacterName}/
#
# Character folders should use actual names (AUTOcurio, DotDot) not IDs (C1, C2)
# Each character folder contains: character.json, front.png, side.png, back.png, voice.m4a
# public_urls in character.json should have both 'front' and 'portrait_front' keys
